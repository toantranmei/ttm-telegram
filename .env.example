# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Lấy API id/hash tại https://my.telegram.org (đăng nhập bằng tài khoản Telegram của bạn).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Tùy chọn. Mặc định ~/.ttm-telegram/session
TELEGRAM_SESSION=
# group_id cách nhau dấu phẩy, hoặc ALL. Để trống = không đọc nhóm nào.
ALLOWED_GROUP_IDS=
# Múi giờ, mặc định Asia/Ho_Chi_Minh
TELEGRAM_TZ=Asia/Ho_Chi_Minh
